# Als .env kopieren und anpassen
APP_NAME=HireFlow
SECRET_KEY=bitte-langen-zufallswert-setzen
COOKIE_SECURE=1
SUPERADMIN_EMAIL=you@example.com
SALES_EMAIL=vertrieb@example.com

# E-Mail-Versand (ohne SMTP_HOST werden Mails nur protokolliert)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=Recruiting
